{
  "name": "career-hub",
  "version": "0.1.0",
  "description": "Private local-first AI resume, email and application tracker for CS/IT applicants",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:ui": "vite build",
    "build": "npm run build:main && npm run build:ui",
    "start": "npm run build && node scripts/start.mjs",
    "check": "npm run typecheck && npm test",
    "e2e": "node scripts/run-e2e.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "smoke:packaged": "node scripts/run-debug.mjs scripts/smoke-packaged.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "docx": "^9.16.0",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
